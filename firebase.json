{
  "hosting": {
    "site": "notakshayp21",
    "public": "portfolio/out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      { "source": "/_next/static/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "/hero/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }] },
      { "source": "**/*.js", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
    ]
  }
}
